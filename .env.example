# Copy this file to .env.local and replace the example values.
# .env.local is git-ignored; never commit real secrets. Values below are FAKE examples showing the format.

# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard -> your project -> Connect -> choose "Pooled connection" and copy the string.
# The host contains "-pooler". Keep ?sslmode=require.
DATABASE_URL=postgresql://neondb_owner:npg_AbCdEf123456@ep-cool-name-a1b2c3d4-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── Better Auth ─────────────────────────────────────────────────
# Any random string of 32+ characters. Generate one with:  openssl rand -base64 32
# (or with Node:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" )
BETTER_AUTH_SECRET=k8Qw3vN1xZr7Yb2mT9pLc4Hd6Fs0JaUe5GiOtRyXnVw=
# Public origin of the app, no trailing slash. Local dev: http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# ── Google sign-in (optional: the button appears only when both are set) ─
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google  (add the production URL later)
GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-AbCdEfGhIjKlMnOpQrStUvWxYz12

# ── Email (Resend) ──────────────────────────────────────────────
# Leave RESEND_API_KEY empty in dev: verification and reset links are printed in the terminal running `npm run dev`.
# resend.com -> API Keys. Format: re_ followed by letters/digits.
RESEND_API_KEY=re_AbCdEfGh_1234567890abcdefghijklmnop
# The sandbox sender only delivers to your own Resend account email. Use a verified domain before launch.
EMAIL_FROM="Vinilium <onboarding@resend.dev>"

# ── Branding placeholders (PLACEHOLDERS - replace before launch) ─
NEXT_PUBLIC_APP_NAME=Vinilium
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Contact URL or email used in the Discogs User-Agent and legal pages.
APP_CONTACT=https://example.com/contact

# ── Discogs (needed from milestone 2) ───────────────────────────
# Two ways to authenticate; set ONE of them. If both are set, KEY + SECRET win.
# All three are server-only and never exposed to the browser.
#
# A) Personal token (simplest): discogs.com -> Settings -> Developers -> Generate new token.
#    Sent as:  Authorization: Discogs token=<token>
DISCOGS_TOKEN=AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCd
# B) App key + secret: discogs.com -> Settings -> Developers -> Create an application.
#    Sent as:  Authorization: Discogs key=<key>, secret=<secret>   (both must be set, or neither)
DISCOGS_CONSUMER_KEY=AbCdEfGhIjKlMnOp
DISCOGS_CONSUMER_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz012345
# One TTL (seconds) for ALL cached Discogs content (API data and the image proxy's Cache-Control). Default 21600 = 6 hours.
DISCOGS_CACHE_TTL_SECONDS=21600

# ── Operations (optional) ───────────────────────────────────────
# Secret for GET /api/cron/purge (deletes expired cache rows). Vercel Cron sends it as "Authorization: Bearer <value>".
# 16+ random characters. The endpoint is disabled while this is empty.
CRON_SECRET=
# Our own per-minute request limits; defaults are search 30/IP 60/user, images 300/IP 600/user. Uncomment to change.
# RL_SEARCH_IP_PER_MIN=30
# RL_SEARCH_USER_PER_MIN=60
# RL_IMAGE_IP_PER_MIN=300
# RL_IMAGE_USER_PER_MIN=600
# Tests only: point the Discogs client at the mock server. NEVER set this in a real environment.
# DISCOGS_API_BASE=http://localhost:3201
